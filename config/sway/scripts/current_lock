## Current Lockscreen ---------------------------------------

DIR="$HOME/.config/sway"

# hyprlock stretches its background image : give it the wallpaper rendered at
# each output's exact size (cached per output / size / wallpaper) : the dot grid
# tiled, or the photo (everforest) cropped to cover the output, and blurred
hyprlock_backgrounds() {
	local cache="$HOME/.cache/neobrutal-lock" colors="$DIR/quickshell/colors.json"
	local bg wall wmode im name w h img blur=0
	bg="$(jq -r '.bg // "#2A2B30"' "$colors" 2>/dev/null)"
	wall="$(jq -r '.wallpaper // ""' "$colors" 2>/dev/null)"
	wmode="$(jq -r '.wallpaper_mode // "tile"' "$colors" 2>/dev/null)"
	[[ "$wmode" == fill ]] && blur=3
	im="magick"; command -v magick >/dev/null 2>&1 || im="convert"
	mkdir -p "$cache"

	# hyprlock rounds the avatar as is : a square copy, so it's a circle like its shadow
	[[ -f "$HOME/.face" ]] && "$im" "$HOME/.face" -gravity center -extent "%[fx:min(w,h)]x%[fx:min(w,h)]" "$cache/avatar.png"

	{
		# flat color first : outputs plugged in later, or a missing wallpaper
		printf 'background {\n    monitor =\n    zindex = -2\n    color = rgba(%d, %d, %d, 1.0)\n}\n' "0x${bg:1:2}" "0x${bg:3:2}" "0x${bg:5:2}"
		[[ -f "$wall" ]] || return 0
		while read -r name w h; do
			[[ -n "$name" ]] || continue
			img="$cache/bg-$name-${w}x$h-${wall##*/}"
			if [[ ! -f "$img" ]]; then
				if [[ "$wmode" == fill ]]; then
					"$im" "$wall" -resize "${w}x$h^" -gravity center -extent "${w}x$h" "$img"
				else
					"$im" -size "${w}x$h" "tile:$wall" "$img"
				fi
			fi
			printf 'background {\n    monitor = %s\n    zindex = -1\n    path = %s\n    blur_passes = %d\n    blur_size = 7\n    brightness = 0.85\n}\n' "$name" "$img" "$blur"
		done < <(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.active) | "\(.name) \(.current_mode.width) \(.current_mode.height)"')
	} > "$cache/hyprlock-bg.conf"
}

# hyprlock when installed (hyprlock-<theme>.conf if the theme has its own layout),
# else the neo brutalism swaylock (scripts/lockscreen)
if command -v hyprlock >/dev/null 2>&1; then
	hyprlock_backgrounds
	conf="$DIR/hyprlock-$(jq -r '.theme // "neobrutal"' "$DIR/quickshell/colors.json" 2>/dev/null).conf"
	[[ -f "$conf" ]] || conf="$DIR/hyprlock.conf"
	hyprlock --config "$conf" &
else
	"$DIR"/scripts/lockscreen
fi
