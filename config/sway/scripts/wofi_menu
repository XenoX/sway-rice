#!/usr/bin/env bash

CONFIG="$HOME/.config/sway/wofi/config"
## wofi loads the style as raw data, so `@import "colors.css"` would resolve from the cwd: inline it
STYLE="${XDG_RUNTIME_DIR:-/tmp}/wofi-style.css"
cat "$HOME/.config/sway/wofi/colors.css" <(grep -v '^@import' "$HOME/.config/sway/wofi/style.css") > "$STYLE"

if [[ ! $(pidof wofi) ]]; then
	wofi --show drun --prompt 'Apps' --conf "${CONFIG}" --style "${STYLE}"
else
	pkill wofi
fi
