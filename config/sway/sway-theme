##-- Style -------------------------------
## Borders, gaps and colors : generated by ~/.config/sway/theme/neobrutal.sh
## (neobrutal | everforest, light | dark) in sway-colors
smart_borders no_gaps
titlebar_padding 8 4
title_align left

include ~/.config/sway/sway-colors

## Toggle light/dark
bindsym $mod+Shift+t exec ~/.config/sway/theme/neobrutal.sh toggle
